{
  "manifest_version": 3,
  "name": "Gitanest",
  "description": "Shows a random Bhagavad Gita verse with its meaning on click.",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "128": "logo.png" }
  },
  "icons": {
    "128": "logo.png"
  },
  "host_permissions": ["https://vedicscriptures.github.io/*"]
}
